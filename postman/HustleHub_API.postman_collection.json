        {
          "name": "Log in freelancer A (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let body = {}",
                  "try { body = pm.response.json() } catch (e) {}",
                  "const decodeBase64 = require('atob')",
                  "let payload = {}",
                  "try { payload = JSON.parse(decodeBase64(body.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/'))) } catch (e) {}",
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200)",
                  "})",
                  "pm.test('A signed token is returned', function () {",
                  "    pm.expect(body.token).to.be.a('string')",
                  "    pm.expect(body.token.split('.')).to.have.lengthOf(3)",
                  "})",
                  "pm.test('Token carries the user id and role only', function () {",
                  "    pm.expect(payload.id).to.eql(pm.collectionVariables.get('freelancerAId'))",
                  "    pm.expect(payload.role).to.eql('freelancer')",
                  "    pm.expect(payload).to.not.have.property('password')",
                  "    pm.expect(payload).to.not.have.property('email')",
                  "})",
                  "pm.test('Token expires within the hour', function () {",
                  "    const left = payload.exp - Math.floor(Date.now() / 1000)",
                  "    pm.expect(left).to.be.within(1, 3600)",
                  "})",
                  "pm.collectionVariables.set('freelancerAToken', body.token)"
                ]
              }
            }
          ],
