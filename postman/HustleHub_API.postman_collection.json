    {
      "name": "00 Setup",
      "item": [
        {
          "name": "Health check (200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString(36)",
                  "pm.collectionVariables.set('runId', runId)",
                  "pm.collectionVariables.set('password', 'Hustle#2026pass')",
                  "pm.collectionVariables.set('freelancerAEmail', 'freya.' + runId + '@example.com')",
                  "pm.collectionVariables.set('freelancerBEmail', 'ben.' + runId + '@example.com')",
                  "pm.collectionVariables.set('clientEmail', 'cleo.' + runId + '@example.com')"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "    pm.response.to.have.status(200)",
                  "})",
                  "pm.test('API reports ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok')",
                  "})"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        }
      ]
    },
